# Railway sets PORT automatically — leave unset locally to default to 4000.
PORT=4000

# Where data.xlsx lives. Locally this defaults to ./data. On Railway, attach a
# Volume (Settings -> Volumes) and set this to its mount path, e.g. /data,
# so the workbook survives redeploys.
DATA_DIR=

# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
# Leave unset locally to allow any origin.
CORS_ORIGIN=

# Required to use POST /api/admin/import (upload the legacy Excel workbook to
# a deployed server, e.g. to seed a Railway Volume). Unset = endpoint always
# refuses. Set this in Railway, pick any long random string.
ADMIN_TOKEN=
