# Railway sets PORT automatically — leave unset locally to default to 4000.
PORT=4000

# Postgres connection string. On Railway: add a Postgres database to your
# project, then in the backend service's Variables tab add a reference to
# it (Railway auto-fills DATABASE_URL). For local dev, use a free Neon.tech
# or Supabase project, or a local Postgres install.
DATABASE_URL=

# Set to "disable" only for a local Postgres that isn't configured for TLS.
# Managed providers (Railway, Neon, Supabase) need SSL, which is on by default.
PGSSL=

# Comma-separated list of allowed frontend origins, e.g.
# https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
# Leave unset locally to allow any origin.
CORS_ORIGIN=

# Required to use POST /api/admin/import (upload the legacy Excel workbook
# straight into a deployed server's database). Unset = endpoint always
# refuses. Set this in Railway, pick any long random string.
ADMIN_TOKEN=
